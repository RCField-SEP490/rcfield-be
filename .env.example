# App
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rcfeild_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (TBD)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Platform
PLATFORM_FEE_PCT=0.15
PAYMENT_WINDOW_MINUTES=30
SLOT_LOCK_TTL_SECONDS=1800

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Email
EMAIL_PROVIDER=Brevo
EMAIL_BREVO_API_KEY=your-brevo-api-key
EMAIL_BREVO_BASE_URL=https://api.brevo.com/v3
EMAIL_FROM_EMAIL=no-reply@rcfield.vn
EMAIL_FROM_NAME=RCField
PASSWORD_RESET_CODE_TTL_MINUTES=30

# AI Chat (Gemini)
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_MODEL=gemini-2.5-pro          # complex RAG queries
GOOGLE_SUPPORT_MODEL=gemini-2.0-flash # simple/fast responses

# NLU Service (internal Docker network — only change if running outside Docker)
NLU_SERVICE_URL=http://nlu-service:8000
NLU_TIMEOUT_MS=200

# Facebook Messenger Channel
# FB_APP_ID / FB_APP_SECRET: get from Meta Developer Console > Your App > Settings > Basic
FB_APP_ID=your-facebook-app-id
FB_APP_SECRET=your-facebook-app-secret
# FB_VERIFY_TOKEN: any random secret you choose, must match what you set in Meta Console > Webhooks
FB_VERIFY_TOKEN=your-random-webhook-verify-token
# FB_REDIRECT_URI: must match exactly what you registered in Meta Console > Facebook Login > Valid OAuth Redirect URIs
FB_REDIRECT_URI=http://localhost:3000/api/v1/channels/facebook/callback
# CHANNEL_ENCRYPTION_KEY: 64 hex chars = 32-byte AES-256 key for encrypting Page tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHANNEL_ENCRYPTION_KEY=replace-with-64-hex-chars
