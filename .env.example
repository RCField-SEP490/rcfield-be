# App
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rcfeild_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment Gateway (TBD)
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html

# Platform
PLATFORM_FEE_PCT=0.15
PAYMENT_WINDOW_MINUTES=30
SLOT_LOCK_TTL_SECONDS=1800

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# AI Chat (Gemini)
GOOGLE_API_KEY=your-gemini-api-key
GOOGLE_EMBEDDING_MODEL=gemini-embedding-001
GOOGLE_MODEL=gemini-2.5-pro          # complex RAG queries
GOOGLE_SUPPORT_MODEL=gemini-2.0-flash # simple/fast responses

# NLU Service (internal Docker network — only change if running outside Docker)
NLU_SERVICE_URL=http://nlu-service:8000
NLU_TIMEOUT_MS=200
