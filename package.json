{
  "name": "rcfeild-be",
  "version": "1.0.0",
  "description": "RCField Backend — Express + TypeScript + TypeORM",
  "main": "dist/app.js",
  "scripts": {
    "dev": "lsof -ti:3000 | xargs kill -9 2>/dev/null; ts-node-dev --respawn --transpile-only src/server.ts",
    "nlu:install": "python3 -m venv nlu-service/.venv && nlu-service/.venv/bin/pip install -r nlu-service/requirements.txt && nlu-service/.venv/bin/python -c \"from sentence_transformers import SentenceTransformer; print('[NLU] Downloading model...'); SentenceTransformer('paraphrase-multilingual-MiniLM-L12-v2'); print('[NLU] Model ready.')\"",
    "nlu": "lsof -ti:8000 | xargs kill -9 2>/dev/null; nlu-service/.venv/bin/python -m uvicorn main:app --port 8000 --reload --app-dir nlu-service",
    "ui": "lsof -ti:5500 | xargs kill -9 2>/dev/null; python3 -m http.server 5500 --directory .",
    "build": "tsc",
    "start": "node dist/server.js",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/config/database.ts",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/config/database.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/config/database.ts",
    "migration:create": "typeorm-ts-node-commonjs migration:create",
    "setup": "npm run migration:run && npm run seed",
    "seed": "ts-node --transpile-only src/seeds/seed-users.ts",
    "seed:cafes": "ts-node --transpile-only src/seeds/seed-cafes.ts",
    "seed:all": "npm run seed && npm run seed:cafes",
    "test:kb": "ts-node --transpile-only src/scripts/test-kb.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "dependencies": {
    "@google/genai": "^2.5.0",
    "@google/generative-ai": "^0.24.1",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.12.0",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0",
    "winston": "^3.19.0",
    "ws": "^8.20.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.59.3"
  }
}
