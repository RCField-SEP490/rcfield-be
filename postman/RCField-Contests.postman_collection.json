{
  "info": {
    "name": "RCField Contests",
    "description": "End-to-end contest flow for provider-owned multi-branch contests. Run after migrations and seed data. Credentials: provider@gmail.com, staff@gmail.com, customer@gmail.com, provider_other@gmail.com; password 123456.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" },
    { "key": "password", "value": "123456" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Provider",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"provider@gmail.com\",\"password\":\"{{password}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('provider login ok', () => pm.response.to.have.status(200));", "const json = pm.response.json();", "pm.collectionVariables.set('provider_token', json.data.access_token);"] } }]
        },
        {
          "name": "Login Staff",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"staff@gmail.com\",\"password\":\"{{password}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('staff login ok', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('staff_token', pm.response.json().data.access_token);"] } }]
        },
        {
          "name": "Login Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"customer@gmail.com\",\"password\":\"{{password}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('customer login ok', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('customer_token', pm.response.json().data.access_token);"] } }]
        },
        {
          "name": "Login Other Provider",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/auth/login",
            "body": { "mode": "raw", "raw": "{\"email\":\"provider_other@gmail.com\",\"password\":\"{{password}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('other provider login ok', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('provider_other_token', pm.response.json().data.access_token);"] } }]
        }
      ]
    },
    {
      "name": "Setup",
      "item": [
        {
          "name": "Get Track Types",
          "request": { "method": "GET", "url": "{{baseUrl}}/track-types" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('track types ok', () => pm.response.to.have.status(200));", "const first = pm.response.json()[0];", "pm.expect(first, 'seed track type').to.exist;", "pm.collectionVariables.set('track_type_id', first.id);"] } }]
        },
        {
          "name": "List Provider Active Cafes",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }],
            "url": "{{baseUrl}}/cafes?scope=managed&status=ACTIVE&limit=10"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('managed cafes ok', () => pm.response.to.have.status(200));", "const cafes = pm.response.json().data || [];", "pm.expect(cafes.length, 'provider needs one ACTIVE cafe').to.be.above(0);", "pm.collectionVariables.set('cafe_id', cafes[0].id);"] } }]
        }
      ]
    },
    {
      "name": "Contest Management",
      "item": [
        {
          "name": "Create Contest Draft",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{provider_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/contests",
            "body": {
              "mode": "raw",
              "raw": "{\"name\":\"Postman Spec Cup {{$timestamp}}\",\"description\":\"Contest created from Postman\",\"track_type_id\":\"{{track_type_id}}\",\"vehicle_rule\":{\"allowed_sources\":[\"BYOC\",\"RENTAL\"]},\"starts_at\":\"2030-06-18T10:00:00.000Z\",\"ends_at\":\"2030-06-18T12:00:00.000Z\",\"registration_opens_at\":\"2026-06-11T00:00:00.000Z\",\"registration_closes_at\":\"2030-06-17T10:00:00.000Z\",\"capacity\":24,\"entry_fee\":0,\"participating_cafe_ids\":[\"{{cafe_id}}\"],\"config\":{\"format\":\"TIME_ATTACK\"}}"
            }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('contest created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('contest_id', pm.response.json().data.id);"] } }]
        },
        {
          "name": "Open Contest",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }], "url": "{{baseUrl}}/contests/{{contest_id}}/open" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('contest opened', () => pm.response.to.have.status(200));", "pm.expect(pm.response.json().data.status).to.eql('OPEN');"] } }]
        },
        { "name": "List Public Contests", "request": { "method": "GET", "url": "{{baseUrl}}/contests?upcoming=true" } },
        { "name": "Contest Detail", "request": { "method": "GET", "url": "{{baseUrl}}/contests/{{contest_id}}" } },
        { "name": "Cafe Contest List", "request": { "method": "GET", "url": "{{baseUrl}}/cafes/{{cafe_id}}/contests" } }
      ]
    },
    {
      "name": "Registration",
      "item": [
        {
          "name": "Customer Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{customer_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/contests/{{contest_id}}/register",
            "body": { "mode": "raw", "raw": "{\"vehicle_source\":\"BYOC\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('customer registered', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('registration_id', pm.response.json().data.id);"] } }]
        },
        {
          "name": "Provider Other Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{provider_other_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/contests/{{contest_id}}/register",
            "body": { "mode": "raw", "raw": "{\"vehicle_source\":\"BYOC\"}" }
          }
        },
        {
          "name": "List Registrations",
          "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }], "url": "{{baseUrl}}/contests/{{contest_id}}/registrations" }
        }
      ]
    },
    {
      "name": "Check-in",
      "item": [
        {
          "name": "Provider Check-in Customer",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{provider_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/contest-registrations/{{registration_id}}/check-in",
            "body": { "mode": "raw", "raw": "{\"cafe_id\":\"{{cafe_id}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('checked in', () => pm.response.to.have.status(200));"] } }]
        }
      ]
    },
    {
      "name": "Competition",
      "item": [
        {
          "name": "Create Class",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{provider_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/contests/{{contest_id}}/classes",
            "body": { "mode": "raw", "raw": "{\"code\":\"POSTMAN\",\"name\":\"Postman Class\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('class created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('contest_class_id', pm.response.json().data.id);"] } }]
        },
        {
          "name": "Create Round",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{provider_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/contests/{{contest_id}}/rounds",
            "body": { "mode": "raw", "raw": "{\"contest_class_id\":\"{{contest_class_id}}\",\"round_type\":\"QUALIFYING\",\"round_no\":1}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('round created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('round_id', pm.response.json().data.id);"] } }]
        },
        {
          "name": "Create Heat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{provider_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/contest-rounds/{{round_id}}/heats",
            "body": { "mode": "raw", "raw": "{\"heat_no\":1}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('heat created', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('heat_id', pm.response.json().data.id);"] } }]
        },
        {
          "name": "Add Heat Entry",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{provider_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/contest-heats/{{heat_id}}/entries",
            "body": { "mode": "raw", "raw": "{\"registration_id\":\"{{registration_id}}\",\"contest_class_id\":\"{{contest_class_id}}\",\"grid_position\":1}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('entry added', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('heat_entry_id', pm.response.json().data.id);"] } }]
        },
        {
          "name": "Submit Time Attack Result",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{provider_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/contest-heats/{{heat_id}}/results",
            "body": { "mode": "raw", "raw": "{\"result_type\":\"TIME_ATTACK\",\"results\":[{\"heat_entry_id\":\"{{heat_entry_id}}\",\"best_lap_ms\":18000}]}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('result submitted', () => pm.response.to.have.status(201));", "pm.collectionVariables.set('result_id', pm.response.json().data[0].id);"] } }]
        },
        {
          "name": "Verify Result",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/contest-results/{{result_id}}/verify", "body": { "mode": "raw", "raw": "{}" } }
        }
      ]
    },
    {
      "name": "Leaderboard",
      "item": [
        { "name": "Get Public Leaderboard", "request": { "method": "GET", "url": "{{baseUrl}}/contests/{{contest_id}}/leaderboard" } },
        { "name": "Publish Leaderboard", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/contests/{{contest_id}}/leaderboard/publish", "body": { "mode": "raw", "raw": "{}" } } }
      ]
    },
    {
      "name": "Rewards",
      "item": [
        {
          "name": "Create Reward",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/contests/{{contest_id}}/rewards",
            "body": { "mode": "raw", "raw": "{\"title\":\"Postman Trophy\",\"reward_type\":\"TROPHY\",\"position\":1}" }
          }
        },
        { "name": "List Rewards", "request": { "method": "GET", "url": "{{baseUrl}}/contests/{{contest_id}}/rewards" } },
        { "name": "Issue Rewards", "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/contests/{{contest_id}}/rewards/issue", "body": { "mode": "raw", "raw": "{}" } } },
        { "name": "My Reward Claims", "request": { "method": "GET", "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }], "url": "{{baseUrl}}/me/contest-reward-claims" } }
      ]
    },
    {
      "name": "Negative Cases",
      "item": [
        {
          "name": "Provider Self Register Should Fail",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/contests/{{contest_id}}/register", "body": { "mode": "raw", "raw": "{\"vehicle_source\":\"BYOC\"}" } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('self registration forbidden', () => pm.response.to.have.status(403));"] } }]
        },
        {
          "name": "Duplicate Customer Register Should Fail",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{customer_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/contests/{{contest_id}}/register", "body": { "mode": "raw", "raw": "{\"vehicle_source\":\"BYOC\"}" } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('duplicate registration conflict', () => pm.response.to.have.status(409));"] } }]
        },
        {
          "name": "Invalid Time Attack Result Should Fail",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/contest-heats/{{heat_id}}/results", "body": { "mode": "raw", "raw": "{\"result_type\":\"TIME_ATTACK\",\"results\":[{\"heat_entry_id\":\"{{heat_entry_id}}\",\"finish_position\":1}]}" } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('invalid result validation error', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Duplicate Reward Issue Should Fail",
          "request": { "method": "POST", "header": [{ "key": "Authorization", "value": "Bearer {{provider_token}}" }, { "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/contests/{{contest_id}}/rewards/issue", "body": { "mode": "raw", "raw": "{}" } },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('duplicate reward issue conflict', () => pm.response.to.have.status(409));"] } }]
        }
      ]
    }
  ]
}
